@model TodoAppMVC.Models.Todo

@{
    ViewData["Title"] = "Yeni Görev Ekle";
}

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="text-primary fw-bold mb-4"><i class="bi bi-plus-circle"></i> Yeni Görev Ekle</h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold">Görev Başlığı</label>
                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Örn: Faturayı öde..." autocomplete="off" autofocus />
                    <span asp-validation-for="Title" class="text-danger fs-7"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Listeye Dön
                    </a>
                    <button type="submit" class="btn btn-success px-5 fw-bold shadow-sm">
                        Kaydet <i class="bi bi-check2"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
