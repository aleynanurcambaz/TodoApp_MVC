@model TodoAppMVC.Models.Todo

@{
    ViewData["Title"] = "Görevi Düzenle";
}

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="text-primary fw-bold mb-4"><i class="bi bi-pencil-square"></i> Görevi Düzenle</h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Görev Başlığı</label>
                    <input asp-for="Title" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger fs-7"></span>
                </div>

                <div class="form-check form-switch mb-4 mt-3">
                    <input class="form-check-input fs-5" type="checkbox" asp-for="IsCompleted">
                    <label class="form-check-label fs-5 ms-2 mt-1" asp-for="IsCompleted">
                        Görev Tamamlandı
                    </label>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Listeye Dön
                    </a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                        Güncelle <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
