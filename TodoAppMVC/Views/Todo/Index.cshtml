@model IEnumerable<TodoAppMVC.Models.Todo>

@{
    ViewData["Title"] = "Gelen Kutusu - Todo Listesi";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold"><i class="bi bi-list-task"></i> Yapılacak İşler Listesi</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Yeni Görev Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-4" style="width: 10%">Durum</th>
                        <th style="width: 55%">Görev Başlığı</th>
                        <th style="width: 15%">Oluşturulma Tarihi</th>
                        <th class="text-end pe-4" style="width: 20%">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-emoji-smile fs-3 d-block mb-2"></i>
                                Henüz hiç görev eklenmemiş. Harika bir gün!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsCompleted ? "table-light text-decoration-line-through text-muted" : "")">
                                <td class="ps-4">
                                    @if (item.IsCompleted)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">Tamamlandı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Bekliyor</span>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Title</td>
                                <td class="text-muted fs-7">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        Düzenle
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Bu görevi silmek istediğinize emin misiniz?')">
                                        Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
